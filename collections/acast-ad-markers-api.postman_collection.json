          "name": "Place or update ad markers",
          "request": {
            "name": "Place or update ad markers",
            "description": {
              "content": "Sets or updates the ad markers on an episode so dynamic ad insertion knows where to place pre-roll, mid-roll, and post-roll ads. Disabling monetization per episode is not supported through the API. Path modeled; the ad-marker-via-PATCH operation is confirmed from documentation.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "shows",
                ":showId",
                "episodes",
                ":episodeId",
                "ad-markers"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "showId",
                  "description": "(Required) The unique identifier of the show."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "episodeId",
                  "description": "(Required) The unique identifier of the episode."

              "raw": "{\n  \"markers\": [\n    {\n      \"type\": \"<string>\",\n      \"offsetSeconds\": \"<integer>\"\n    },\n    {\n      \"type\": \"<string>\",\n      \"offsetSeconds\": \"<integer>\"\n    }\n  ]\n}",
